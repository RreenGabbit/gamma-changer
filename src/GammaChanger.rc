#include <windows.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

1 RT_MANIFEST "GammaChanger.manifest"

1 VERSIONINFO
 FILEVERSION 1,2,0,0
 PRODUCTVERSION 1,2,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Gamma Changer\0"
            VALUE "FileDescription", "Windows hardware gamma-ramp utility\0"
            VALUE "FileVersion", "1.2.0\0"
            VALUE "InternalName", "GammaChanger\0"
            VALUE "OriginalFilename", "GammaChanger.exe\0"
            VALUE "ProductName", "Gamma Changer\0"
            VALUE "ProductVersion", "1.2.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
